# Copia este archivo a .env y completa lo que uses.
# El .env está en .gitignore: los secretos NUNCA se commitean.

# Postgres (docker compose)
POSTGRES_PASSWORD=agent

# Caja inicial del broker simulado (USD)
STARTING_CASH_USD=10000

# Bot de Telegram: crea uno con @BotFather y pega el token aquí
TELEGRAM_BOT_TOKEN=
# Tu chat id (habla con @userinfobot para obtenerlo). Si se define,
# el bot ignora cualquier otro chat.
TELEGRAM_CHAT_ID=

# API key de Claude (console.anthropic.com) para el analista IA (fase 3).
# Sin key, el agente usa un analista de reglas (momentum) — todo funciona igual.
# Costo estimado del análisis diario: < USD 10/mes. NUNCA se commitea.
ANTHROPIC_API_KEY=
